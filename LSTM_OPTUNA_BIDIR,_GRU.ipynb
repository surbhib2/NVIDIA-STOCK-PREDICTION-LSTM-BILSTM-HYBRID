      "source": [
        "# enhanced_lstm_optuna_nvda.py\n",
        "# Run in Python 3.8+ environment (Colab recommended)\n",
        "!pip install optuna tensorflow yfinance ta matplotlib seaborn\n",
        "\n",
        "import os\n",
        "import math\n",
        "import random\n",
        "import warnings\n",
        "from datetime import datetime, timedelta\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import yfinance as yf\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# ML / DL\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, Dense, Dropout, Bidirectional, GRU\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "# Hyperparameter tuning\n",
        "try:\n",
        "    import optuna\n",
        "except Exception:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install --quiet optuna\n",
        "    import optuna\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "sns.set_style(\"whitegrid\")\n",
        "\n",
        "# -------------------- CONFIG --------------------\n",
        "TICKER = \"NVDA\"\n",
        "SPY = \"^GSPC\"\n",
        "YEARS = 5\n",
        "END_DATE = datetime.today().strftime(\"%Y-%m-%d\")\n",
        "START_DATE = (datetime.today() - timedelta(days=YEARS * 365)).strftime(\"%Y-%m-%d\")\n",
        "\n",
        "RANDOM_SEED = 42\n",
        "np.random.seed(RANDOM_SEED)\n",
        "tf.random.set_seed(RANDOM_SEED)\n",
        "random.seed(RANDOM_SEED)\n",
        "\n",
        "SEQ_DEFAULT = 60\n",
        "TEST_DAYS = 90\n",
        "N_TRIALS = 25  # increase for stronger tuning\n",
        "MAX_EPOCHS = 80\n",
        "\n",
        "# -------------------- UTIL: cleaning & features --------------------\n",
        "def flatten_columns_if_needed(df):\n",
        "    if isinstance(df.columns, pd.MultiIndex):\n",
        "        df.columns = ['_'.join(col).strip() for col in df.columns.values]\n",
        "    return df\n",
        "\n",
        "def clean_and_fill_missing(df, window=5):\n",
        "    df = df.copy()\n",
        "    null_like = ['null', 'NULL', 'NaN', 'nan', '-', '--', ' ', '', 'None', 'none']\n",
        "    df.replace(null_like, np.nan, inplace=True)\n",
        "    # try to coerce numeric-like strings\n",
        "    for col in df.columns:\n",
        "        if df[col].dtype == object:\n",
        "            df[col] = pd.to_numeric(df[col], errors='ignore')\n",
        "    for col in df.columns:\n",
        "        if np.issubdtype(df[col].dtype, np.number):\n",
        "            n_missing = df[col].isna().sum()\n",
        "            if n_missing > 0:\n",
        "                fwd = df[col].fillna(method='ffill', limit=window)\n",
        "                bwd = df[col].fillna(method='bfill', limit=window)\n",
        "                df[col] = (fwd + bwd) / 2.0\n",
        "                df[col].fillna(df[col].mean(), inplace=True)\n",
        "        else:\n",
        "            if df[col].isna().sum() > 0:\n",
        "                df[col].fillna(method='ffill', inplace=True)\n",
        "                df[col].fillna(method='bfill', inplace=True)\n",
        "    return df\n",
        "\n",
        "def add_technical_indicators(df, price_col='Close'):\n",
        "    # expects df indexed by datetime and contains Close column\n",
        "    df = df.copy()\n",
        "    close = df[price_col]\n",
        "    # returns\n",
        "    df['Return'] = close.pct_change().fillna(0)\n",
        "    # SMA / EMA\n",
        "    df['SMA_10'] = close.rolling(10).mean()\n",
        "    df['SMA_30'] = close.rolling(30).mean()\n",
        "    df['EMA_10'] = close.ewm(span=10, adjust=False).mean()\n",
        "    df['EMA_30'] = close.ewm(span=30, adjust=False).mean()\n",
        "    # Bollinger\n",
        "    ma20 = close.rolling(20).mean()\n",
        "    sd20 = close.rolling(20).std()\n",
        "    df['BB_upper'] = ma20 + 2 * sd20\n",
        "    df['BB_lower'] = ma20 - 2 * sd20\n",
        "    # RSI\n",
        "    delta = close.diff()\n",
        "    up = delta.clip(lower=0)\n",
        "    down = -1 * delta.clip(upper=0)\n",
        "    roll_up = up.rolling(14).mean()\n",
        "    roll_down = down.rolling(14).mean()\n",
        "    rs = roll_up / (roll_down + 1e-9)\n",
        "    df['RSI'] = 100 - (100 / (1 + rs))\n",
        "    # MACD\n",
        "    ema12 = close.ewm(span=12, adjust=False).mean()\n",
        "    ema26 = close.ewm(span=26, adjust=False).mean()\n",
        "    df['MACD'] = ema12 - ema26\n",
        "    # Fill small NaNs created by indicators\n",
        "    df.fillna(method='bfill', inplace=True)\n",
        "    df.fillna(method='ffill', inplace=True)\n",
        "    return df\n",
        "\n",
        "# -------------------- DOWNLOAD & PREP --------------------\n",
        "print(\"Downloading data...\")\n",
        "nvda_raw = yf.download(TICKER, start=START_DATE, end=END_DATE, progress=False)\n",
        "spy_raw = yf.download(SPY, start=START_DATE, end=END_DATE, progress=False)\n",
        "\n",
        "# Flatten if multiindex\n",
        "nvda_raw = flatten_columns_if_needed(nvda_raw)\n",
        "spy_raw = flatten_columns_if_needed(spy_raw)\n",
        "\n",
        "# Keep basics\n",
        "nvda = nvda_raw[['Open_NVDA', 'High_NVDA', 'Low_NVDA', 'Close_NVDA', 'Volume_NVDA']].copy()\n",
        "spy = spy_raw[['Close_^GSPC']].copy().rename(columns={'Close_^GSPC': 'SPY_Close'})\n",
        "\n",
        "# Clean\n",
        "nvda = clean_and_fill_missing(nvda, window=5)\n",
        "spy = clean_and_fill_missing(spy, window=5)\n",
        "\n",
        "# Merge\n",
        "df = nvda.join(spy, how='inner')\n",
        "df.index.name = 'Date'\n",
        "df.reset_index(inplace=False)\n",
        "\n",
        "# Add technicals\n",
        "df = add_technical_indicators(df, price_col='Close_NVDA')\n",
        "\n",
        "# Final cleaning\n",
        "df = df.dropna().copy()\n",
        "print(\"Prepared data shape:\", df.shape)\n",
        "print(df.columns.tolist())\n",
        "\n",
        "# -------------------- FEATURES & TARGET --------------------\n",
        "# Use these features (you can add/remove)\n",
        "feature_cols = [\n",
        "    'Open_NVDA', 'High_NVDA', 'Low_NVDA', 'Close_NVDA', 'Volume_NVDA', 'SPY_Close',\n",
        "    'Return', 'SMA_10', 'SMA_30', 'EMA_10', 'EMA_30',\n",
        "    'BB_upper', 'BB_lower', 'RSI', 'MACD'\n",
        "]\n",
        "for c in feature_cols:\n",
        "    if c not in df.columns:\n",
        "        raise RuntimeError(f\"Missing feature column: {c}\")\n",
        "\n",
        "# Ensure datetime index for sequence mapping\n",
        "dates = df.index  # DatetimeIndex\n",
        "target_col_name = 'Close_NVDA'   # predict next-day Close\n",
        "print(\"Dates range:\", dates.min(), \"to\", dates.max())\n",
        "\n",
        "# -------------------- SCALER & SEQUENCES --------------------\n",
        "scaler = MinMaxScaler()\n",
        "scaled_all = scaler.fit_transform(df[feature_cols].values)\n",
        "scaled_df = pd.DataFrame(scaled_all, index=df.index, columns=feature_cols)\n",
        "\n",
        "def create_sequences(values, seq_len, target_idx):\n",
        "    X, y = [], []\n",
        "    for i in range(seq_len, len(values)):\n",
        "        X.append(values[i-seq_len:i])\n",
        "        y.append(values[i, target_idx])  # predict closing price scaled\n",
        "    return np.array(X), np.array(y)\n",
        "\n",
        "# We will tune seq_len as hyperparam; set default initial\n",
        "SEQ_LEN = SEQ_DEFAULT\n",
        "target_idx = feature_cols.index(target_col_name)\n",
        "\n",
        "# -------------------- TRAIN/TEST SPLIT (by dates) --------------------\n",
        "dates_all = df.index[SEQ_LEN:]\n",
        "test_start_idx = len(df) - TEST_DAYS\n",
        "print(\"Test start index (in original df):\", test_start_idx)\n",
        "\n",
        "# -------------------- OPTUNA objective --------------------\n",
        "def build_model(trial, input_shape):\n",
        "    model_type = trial.suggest_categorical(\"model_type\", [\"LSTM\", \"BiLSTM\", \"GRU\"])\n",
        "    n_layers = trial.suggest_int(\"n_layers\", 1, 3)\n",
        "    units = trial.suggest_categorical(\"units\", [64, 128, 256])\n",
        "    dropout = trial.suggest_float(\"dropout\", 0.0, 0.5)\n",
        "    lr = trial.suggest_loguniform(\"lr\", 1e-5, 1e-3)\n",
        "\n",
        "    model = Sequential()\n",
        "    for i in range(n_layers):\n",
        "        return_seq = (i < n_layers - 1)\n",
        "        units_layer = units\n",
        "        if model_type == \"LSTM\":\n",
        "            if i == 0:\n",
        "                model.add(LSTM(units_layer, return_sequences=return_seq, input_shape=input_shape))\n",
        "            else:\n",
        "                model.add(LSTM(units_layer, return_sequences=return_seq))\n",
        "        elif model_type == \"BiLSTM\":\n",
        "            if i == 0:\n",
        "                model.add(Bidirectional(LSTM(units_layer, return_sequences=return_seq), input_shape=input_shape))\n",
        "            else:\n",
        "                model.add(Bidirectional(LSTM(units_layer, return_sequences=return_seq)))\n",
        "        else:  # GRU\n",
        "            if i == 0:\n",
        "                model.add(GRU(units_layer, return_sequences=return_seq, input_shape=input_shape))\n",
        "            else:\n",
        "                model.add(GRU(units_layer, return_sequences=return_seq))\n",
        "        if dropout > 0:\n",
        "            model.add(Dropout(dropout))\n",
        "\n",
        "    model.add(Dense(32, activation='relu'))\n",
        "    model.add(Dense(1))\n",
        "    opt = Adam(learning_rate=lr)\n",
        "    model.compile(optimizer=opt, loss='mse')\n",
        "    return model\n",
        "\n",
        "def objective(trial):\n",
        "    # hyperparams to try\n",
        "    seq_len = trial.suggest_int(\"seq_len\", 30, 90, step=10)\n",
        "    batch_size = trial.suggest_categorical(\"batch_size\", [16, 32, 64])\n",
        "    val_split = 0.1\n",
        "\n",
        "    # prepare sequences with seq_len\n",
        "    X, y = create_sequences(scaled_df.values, seq_len, target_idx)\n",
        "    # align train/test by time: last TEST_DAYS are test\n",
        "    X_train, y_train = X[: -TEST_DAYS], y[: -TEST_DAYS]\n",
        "    X_val, y_val = X[-TEST_DAYS - int(len(X)*0.0) : -TEST_DAYS], y[-TEST_DAYS - int(len(X)*0.0) : -TEST_DAYS]  # small val taken from training via validation_split in fit\n",
        "    # We'll use validation_split in Keras.fit; but to keep optuna stable, use validation_split param\n",
        "    input_shape = (X_train.shape[1], X_train.shape[2])\n",
        "\n",
        "    model = build_model(trial, input_shape)\n",
        "    # callbacks\n",
        "    early_stop = tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=8, restore_best_weights=True)\n",
        "    # fit\n",
        "    history = model.fit(\n",
        "        X_train, y_train,\n",
        "        validation_split=val_split,\n",
        "        batch_size=batch_size,\n",
        "        epochs=MAX_EPOCHS,\n",
        "        callbacks=[early_stop],\n",
        "        verbose=0\n",
        "    )\n",
        "    # Validate on final TEST_DAYS portion (simulate unseen)\n",
        "    X_test_cv, y_test_cv = X[-TEST_DAYS:], y[-TEST_DAYS:]\n",
        "    y_pred_scaled = model.predict(X_test_cv, verbose=0).reshape(-1)\n",
        "    # inverse scale predictions for the Close column\n",
        "    # prepare inverted arrays\n",
        "    inv_pred = np.zeros((len(y_pred_scaled), len(feature_cols)))\n",
        "    inv_true = np.zeros((len(y_test_cv), len(feature_cols)))\n",
        "    inv_pred[:, target_idx:target_idx+1] = y_pred_scaled.reshape(-1,1)\n",
        "    inv_true[:, target_idx:target_idx+1] = y_test_cv.reshape(-1,1)\n",
        "    inv_pred = scaler.inverse_transform(inv_pred)[:, target_idx]\n",
        "    inv_true = scaler.inverse_transform(inv_true)[:, target_idx]\n",
        "    rmse = mean_squared_error(inv_true, inv_pred)\n",
        "    return rmse\n",
        "\n",
        "# -------------------- RUN OPTUNA --------------------\n",
        "print(\"Starting Optuna tuning...\")\n",
        "study = optuna.create_study(direction=\"minimize\", sampler=optuna.samplers.TPESampler(seed=RANDOM_SEED))\n",
        "study.optimize(objective, n_trials=N_TRIALS, show_progress_bar=True)\n",
        "\n",
        "print(\"Best trial:\")\n",
        "best = study.best_trial\n",
        "print(best.params)\n",
        "\n",
        "# -------------------- TRAIN FINAL MODEL WITH BEST HYPERPARAMS --------------------\n",
        "best_params = best.params\n",
        "SEQ_LEN = best_params.get('seq_len', SEQ_DEFAULT)\n",
        "BATCH = best_params.get('batch_size', 32)\n",
        "\n",
        "# create final sequences\n",
        "X_all, y_all = create_sequences(scaled_df.values, SEQ_LEN, target_idx)\n",
        "X_train_final, y_train_final = X_all[:-TEST_DAYS], y_all[:-TEST_DAYS]\n",
        "X_test_final, y_test_final = X_all[-TEST_DAYS:], y_all[-TEST_DAYS:]\n",
        "dates_test = df.index[SEQ_LEN:][ -TEST_DAYS : ]\n",
        "\n",
        "# build model with best params\n",
        "def build_model_from_params(params, input_shape):\n",
        "    # re-use build_model style but with explicit params\n",
        "    model_type = params.get('model_type', 'LSTM')\n",
        "    n_layers = params.get('n_layers', 2)\n",
        "    units = params.get('units', 128)\n",
        "    dropout = params.get('dropout', 0.2)\n",
        "    lr = params.get('lr', 1e-4)\n",
        "\n",
        "    model = Sequential()\n",
        "    for i in range(n_layers):\n",
        "        return_seq = (i < n_layers - 1)\n",
        "        if model_type == \"LSTM\":\n",
        "            if i == 0:\n",
        "                model.add(LSTM(units, return_sequences=return_seq, input_shape=input_shape))\n",
        "            else:\n",
        "                model.add(LSTM(units, return_sequences=return_seq))\n",
        "        elif model_type == \"BiLSTM\":\n",
        "            if i == 0:\n",
        "                model.add(Bidirectional(LSTM(units, return_sequences=return_seq), input_shape=input_shape))\n",
        "            else:\n",
        "                model.add(Bidirectional(LSTM(units, return_sequences=return_seq)))\n",
        "        else:\n",
        "            if i == 0:\n",
        "                model.add(GRU(units, return_sequences=return_seq, input_shape=input_shape))\n",
        "            else:\n",
        "                model.add(GRU(units, return_sequences=return_seq))\n",
        "        if dropout > 0:\n",
        "            model.add(Dropout(dropout))\n",
        "    model.add(Dense(32, activation='relu'))\n",
        "    model.add(Dense(1))\n",
        "    model.compile(optimizer=Adam(learning_rate=lr), loss='mse')\n",
        "    return model\n",
        "\n",
        "input_shape = (X_train_final.shape[1], X_train_final.shape[2])\n",
        "model_final = build_model_from_params(best_params, input_shape)\n",
        "es = tf.keras.callbacks.EarlyStopping(monitor='val_loss', patience=12, restore_best_weights=True)\n",
        "history = model_final.fit(X_train_final, y_train_final, validation_split=0.1,\n",
        "                          epochs=200, batch_size=BATCH, callbacks=[es], verbose=1)\n",
        "\n",
        "# -------------------- PREDICT & INVERSE SCALE --------------------\n",
        "y_pred_scaled = model_final.predict(X_test_final).reshape(-1)\n",
        "inv_pred = np.zeros((len(y_pred_scaled), len(feature_cols)))\n",
        "inv_true = np.zeros((len(y_test_final), len(feature_cols)))\n",
        "inv_pred[:, target_idx:target_idx+1] = y_pred_scaled.reshape(-1,1)\n",
        "inv_true[:, target_idx:target_idx+1] = y_test_final.reshape(-1,1)\n",
        "\n",
        "inv_pred = scaler.inverse_transform(inv_pred)[:, target_idx]\n",
        "inv_true = scaler.inverse_transform(inv_true)[:, target_idx]\n",
        "\n",
        "# -------------------- METRICS --------------------\n",
        "mae = mean_absolute_error(inv_true, inv_pred)\n",
        "rmse = mean_squared_error(inv_true, inv_pred)\n",
        "mape = np.mean(np.abs((inv_true - inv_pred) / inv_true)) * 100\n",
        "r2 = r2_score(inv_true, inv_pred)\n",
        "\n",
        "print(\"\\n📊 Final LSTM (tuned) Performance\")\n",
        "print(f\"MAE : {mae:.2f}\")\n",
        "print(f\"RMSE: {rmse:.2f}\")\n",
        "print(f\"MAPE: {mape:.2f}%\")\n",
        "print(f\"R²  : {r2:.3f}\")\n",
        "\n",
        "# -------------------- PLOTS --------------------\n",
        "plt.figure(figsize=(12,5))\n",
        "plt.plot(dates_test, inv_true, label='Actual', linewidth=2)\n",
        "plt.plot(dates_test, inv_pred, label='Predicted', linestyle='--')\n",
        "plt.title(\"LSTM Tuned Predictions vs Actual (NVDA)\")\n",
        "plt.legend()\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(8,4))\n",
        "sns.histplot(inv_true - inv_pred, kde=True)\n",
        "plt.title(\"Prediction Error Distribution (Actual - Pred)\")\n",
        "plt.show()\n",
        "\n",
        "# -------------------- SAVE MODEL & SCALER --------------------\n",
        "model_final.save(\"lstm_nvda_tuned.h5\")\n",
        "import joblib\n",
        "joblib.dump(scaler, \"scaler_nvda_tuned.save\")\n",
        "print(\"Saved model -> lstm_nvda_tuned.h5 and scaler -> scaler_nvda_tuned.save\")\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "\n",
        "# ---------- METRICS ----------\n",
        "mae = mean_absolute_error(inv_true, inv_pred)\n",
        "rmse = mean_squared_error(inv_true, inv_pred)\n",
        "mape = np.mean(np.abs((inv_true - inv_pred) / inv_true)) * 100\n",
        "r2 = r2_score(inv_true, inv_pred)\n",
        "\n",
        "print(\"📊 MODEL EVALUATION RESULTS\")\n",
        "print(f\"MAE  (Mean Abs Error)        : {mae:.2f}\")\n",
        "print(f\"RMSE (Root Mean Sq Error)    : {rmse:.2f}\")\n",
        "print(f\"MAPE (Mean Abs % Error)      : {mape:.2f}%\")\n",
        "print(f\"R²   (Explained Variance)    : {r2:.3f}\")\n",
        "\n",
        "# ---------- DATAFRAME ----------\n",
        "results_df = pd.DataFrame({\n",
        "    'Date': dates_test,\n",
        "    'Actual': inv_true,\n",
        "    'Predicted': inv_pred\n",
        "})\n",
        "results_df['Error'] = results_df['Actual'] - results_df['Predicted']\n",
        "results_df.set_index('Date', inplace=True)\n",
        "\n",
        "# ---------- PLOT: Actual vs Predicted ----------\n",
        "plt.figure(figsize=(12,6))\n",
        "plt.plot(results_df.index, results_df['Actual'], label='Actual', linewidth=2)\n",
        "plt.plot(results_df.index, results_df['Predicted'], label='Predicted', linestyle='--', alpha=0.8)\n",
        "plt.fill_between(results_df.index,\n",
        "                 results_df['Predicted'] - rmse,\n",
        "                 results_df['Predicted'] + rmse,\n",
        "                 color='gray', alpha=0.1, label='±1 RMSE Band')\n",
        "plt.title(\"LSTM Model — Actual vs Predicted Close Price\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Price ($)\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------- PLOT: Residual Distribution ----------\n",
        "plt.figure(figsize=(8,4))\n",
        "sns.histplot(results_df['Error'], bins=30, kde=True, color='purple')\n",
        "plt.title(\"Residual Distribution (Actual - Predicted)\")\n",
        "plt.xlabel(\"Prediction Error ($)\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.axvline(0, color='black', linestyle='--')\n",
        "plt.show()\n",
        "\n",
        "# ---------- PLOT: Residuals Over Time ----------\n",
        "plt.figure(figsize=(12,4))\n",
        "plt.plot(results_df.index, results_df['Error'], color='orange', linewidth=1.5)\n",
        "plt.axhline(0, color='black', linestyle='--', alpha=0.7)\n",
        "plt.title(\"Prediction Residuals Over Time\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.ylabel(\"Residual ($)\")\n",
        "plt.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ---------- Optional: Rolling Accuracy ----------\n",
        "rolling_window = 7\n",
        "results_df['Rolling_RMSE'] = results_df['Error'].rolling(rolling_window).apply(lambda x: np.sqrt(np.mean(x**2)))\n",
        "results_df['Rolling_MAPE'] = results_df['Error'].rolling(rolling_window).apply(\n",
        "    lambda x: np.mean(np.abs(x) / results_df['Actual'].loc[x.index]) * 100\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(12,4))\n",
        "plt.plot(results_df.index, results_df['Rolling_MAPE'], label=f'{rolling_window}-day Rolling MAPE', color='blue')\n",
        "plt.title(\"Rolling Prediction Accuracy (MAPE)\")\n",
        "plt.ylabel(\"Error (%)\")\n",
        "plt.xlabel(\"Date\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
